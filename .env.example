# Environment variable template
# Copy to .env and fill in values

# Required: GitHub API token with repo scope
GITHUB_TOKEN=your-github-token-here

# Required: Repository in owner/repo format
GITHUB_REPO=owner/repo

# Required: GitHub webhook secret (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=your-webhook-secret-here

# Required: Sentinel bot's GitHub login
SENTINEL_BOT_LOGIN=sentinel-bot

# Optional: Service configuration
NOTIFIER_PORT=8000
DEBUG=false

# Optional: Sentinel configuration
POLL_INTERVAL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=300
PROMPT_TIMEOUT_SECONDS=5700
INFRA_TIMEOUT_SECONDS=300
MAX_RETRIES=3
